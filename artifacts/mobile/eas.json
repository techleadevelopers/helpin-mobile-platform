{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "https://zoohelp-core-production.up.railway.app",
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "REPLACE_WITH_EAS_SECRET"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://zoohelp-core-production.up.railway.app",
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "REPLACE_WITH_EAS_SECRET"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://zoohelp-core-production.up.railway.app",
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "REPLACE_WITH_EAS_SECRET"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "${ASC_APP_ID}",
        "appleTeamId": "${APPLE_TEAM_ID}"
      }
    }
  }
}
