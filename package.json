{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test:contracts": "node --test tests/contracts/backend-contract.test.mjs",
    "test:load": "node tests/contracts/backend-load-smoke.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10",
      "qs": ">=6.15.2",
      "uuid": ">=11.1.1"
    }
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
